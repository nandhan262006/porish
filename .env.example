# CMS / Admin (Phase 1)
ADMIN_PASSWORD=change-me
SESSION_SECRET=minimum-32-characters-long-secret-here

# Local file DB by default; later: libsql://<db>.turso.io
TURSO_DATABASE_URL=file:./data/cms.db
# TURSO_AUTH_TOKEN=

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=
